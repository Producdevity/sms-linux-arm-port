set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
foreach(required SMS_SYSROOT SMS_CLANG SMS_CLANGXX SMS_LLD)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Set ${required} to an installed target toolchain path")
    endif()
endforeach()
set(CMAKE_SYSROOT "${SMS_SYSROOT}")
set(CMAKE_C_COMPILER "${SMS_CLANG}")
set(CMAKE_CXX_COMPILER "${SMS_CLANGXX}")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
# Handheld targets are Cortex-A53: tune for the in-order core and apply its
# multiply-accumulate (835769) and ADRP (843419) erratum workarounds.
set(sms_cpu_flags "-mcpu=cortex-a53 -mfix-cortex-a53-835769")
set(CMAKE_C_FLAGS_INIT "--no-default-config --gcc-toolchain=${SMS_SYSROOT}/usr ${sms_cpu_flags}")
set(CMAKE_CXX_FLAGS_INIT "--no-default-config --gcc-toolchain=${SMS_SYSROOT}/usr ${sms_cpu_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "--ld-path=${SMS_LLD} -Wl,--fix-cortex-a53-843419")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "--ld-path=${SMS_LLD} -Wl,--fix-cortex-a53-843419")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    SMS_SYSROOT SMS_CLANG SMS_CLANGXX SMS_LLD)
